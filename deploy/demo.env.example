# Local demo settings for deploy/compose.production.yaml with the demo overlay:
# every process in Docker, real AI output from OpenRouter, and no sign-in.
#
#   cp deploy/demo.env.example deploy/production.env   # git-ignored
#   docker compose -f deploy/compose.production.yaml -f deploy/compose.demo.yaml up -d
#
# The overlay sets APP_ENV=development and IDENTITY_PROVIDER=fake and publishes
# the app on 127.0.0.1 only; without it the manifest runs in production mode.
# Then set OPENROUTER_API_KEY below. The manifest itself sets the scanner
# address, LOG_FORMAT=json and the metrics exporter.
# Never expose a demo stack beyond your own machine: anyone who can reach it can
# act as any development persona. For a real deployment start from
# deploy/production.env.example instead.

# Development mode allows the fake personas and fake architecture knowledge.
APP_ENV=development
IDENTITY_PROVIDER=fake

# Storage: the stack's PostgreSQL container. The manifest sets DATABASE_URL
# from POSTGRES_PASSWORD in deploy/.env, and overrides any value here.
PERSISTENCE_PROVIDER=postgres

# AI: OpenRouter for generation and for requirement-knowledge embeddings.
# Create a key at https://openrouter.ai/keys; the stack refuses to start
# without one. The free chat model is rate-limited and meant for demos only;
# the embedding model is billed to the key's account. OpenRouter never falls
# back to a paid chat model. For offline sample output with no key instead,
# set LLM_PROVIDER=fake and leave the OPENROUTER_ lines as they are.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Route only to providers that do not collect your data; the only accepted value.
OPENROUTER_DATA_COLLECTION=deny

# Architecture mapping uses the provider above (its model and embedding).

# Shared-library uploads are scanned by the stack's ClamAV container.
ATTACHMENT_SCAN_MODE=clamav

PROVIDER_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
