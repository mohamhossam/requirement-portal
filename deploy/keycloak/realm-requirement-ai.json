{
  "realm": "requirement-ai",
  "enabled": true,
  "displayName": "Requirement AI",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined)",
  "loginTheme": "requirement-ai",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "Requirement AI",
    "auth": "true",
    "user": "${SMTP_USERNAME}",
    "password": "${SMTP_PASSWORD}",
    "starttls": "true"
  },
  "clients": [
    {
      "clientId": "requirement-spa",
      "name": "Requirement AI browser",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${REQUIREMENT_APP_ORIGIN}",
      "baseUrl": "${REQUIREMENT_APP_ORIGIN}",
      "redirectUris": [
        "${REQUIREMENT_APP_ORIGIN}/auth/callback",
        "${REQUIREMENT_APP_ORIGIN}/auth/silent-callback"
      ],
      "webOrigins": [
        "${REQUIREMENT_APP_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${REQUIREMENT_APP_ORIGIN}/*"
      },
      "protocolMappers": [
        {
          "name": "requirement-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "requirement-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "requirement-service",
      "name": "Requirement AI service",
      "description": "Requirement work's own credential for the knowledge portal's internal API (ADR-0104). Keycloak generates its secret; set it as REQUIREMENT_SERVICE_CLIENT_SECRET.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "knowledge-internal-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "knowledge-internal",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "architecture_reader",
        "description": "Starts and reads architecture mapping for the Requirements they work on."
      },
      {
        "name": "architecture_maintainer",
        "description": "Also cancels and retries other people's architecture mapping jobs."
      }
    ]
  },
  "groups": [
    {
      "name": "architecture-readers",
      "path": "/architecture-readers",
      "realmRoles": [
        "architecture_reader"
      ]
    },
    {
      "name": "architecture-maintainers",
      "path": "/architecture-maintainers",
      "realmRoles": [
        "architecture_reader",
        "architecture_maintainer"
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "deny-unlinked-company-sso",
      "description": "Microsoft access requires an administrator-created identity link.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "company-sso",
      "displayName": "Microsoft",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "deny-unlinked-company-sso",
      "config": {
        "clientId": "${ENTRA_CLIENT_ID}",
        "clientSecret": "${ENTRA_CLIENT_SECRET}",
        "issuer": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0",
        "authorizationUrl": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/oauth2/v2.0/token",
        "userInfoUrl": "https://graph.microsoft.com/oidc/userinfo",
        "jwksUrl": "https://login.microsoftonline.com/${ENTRA_TENANT_ID}/discovery/v2.0/keys",
        "defaultScope": "openid profile email",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "syncMode": "IMPORT"
      }
    }
  ]
}
