# The API path without the /api prefix, still percent-encoded and with its
# query string, matching the development proxy.
map $request_uri $api_request_uri {
    ~^/api(?<api_path>/.*)$ $api_path;
}

# Per client address (ADR-0106): one address flooding the API cannot starve
# everyone else. Impact preview recomputes a Requirement's impact on every
# keystroke pause, so it gets a stricter budget of its own.
limit_req_zone $binary_remote_addr zone=api_per_address:10m rate=${EDGE_RATE_PER_SECOND}r/s;
limit_req_zone $binary_remote_addr zone=impact_preview_per_address:1m rate=2r/s;
limit_req_status 429;

# What follows /knowledge/ in an old bookmark, query string included, for the
# redirect to the knowledge portal's own address (ADR-0104).
map $request_uri $knowledge_bookmark {
    ~^/knowledge/(?<knowledge_rest>.*)$ $knowledge_rest;
}

server {
    listen 8080;
    server_tokens off;
    # The client's own address, as the TLS proxy in front of this edge reports it,
    # so limits and logs see people rather than the proxy. Only TRUSTED_PROXY_CIDR
    # may say who the client is; the default trusts no one.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    # Redirects name a path, not this container's port: the published port
    # (WEB_PORT) or a TLS proxy in front decides the origin.
    absolute_redirect off;
    root /usr/share/nginx/html;

    # Docker's embedded DNS. Upstream names are re-resolved at request time, so
    # a recreated container (new IP) is reached without restarting this proxy.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Documents are capped at 10 MiB (DOCUMENT_MAX_FILE_BYTES) in both services;
    # the extra headroom is multipart framing. Keep the three in step.
    client_max_body_size 12m;

    # Compress the static app only. Proxied API responses stay uncompressed
    # (gzip_proxied defaults to off), because compressing responses that
    # reflect user input next to secrets invites BREACH-style attacks.
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml application/json text/plain;

    # Hashed build assets never change, so they cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Service-to-service routes are never reachable from a browser (ADR-0099).
    # A path that only normalises to /internal is caught too: the location
    # match runs on the decoded, merged path.
    location ^~ /api/internal {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # The API's generated documentation describes every route to anyone; it is
    # for developers on their own machine, not for the public edge.
    location ^~ /api/docs {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    location = /api/redoc {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    location = /api/openapi.json {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    # The knowledge portal has its own address (ADR-0104). Its API is not served
    # here, and old /knowledge/ bookmarks go to KNOWLEDGE_PORTAL_URL for one
    # release; with that unset they are not found.
    location ^~ /knowledge-api/ {
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    location ^~ /knowledge/ {
        include /etc/nginx/snippets/security-headers.conf;
        set $knowledge_portal_url "${KNOWLEDGE_PORTAL_URL}";
        if ($knowledge_portal_url = "") {
            return 404;
        }
        return 301 $knowledge_portal_url$knowledge_bookmark;
    }

    location = /knowledge {
        return 301 /knowledge/;
    }

    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        # A variable in proxy_pass makes nginx resolve the host per request.
        proxy_pass ${API_UPSTREAM}$api_request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # One correlation ID from the edge to the API's logs and error bodies.
        proxy_set_header X-Request-ID $request_id;
        # Model work runs as durable jobs (ADR-0105), so no request waits on a
        # model; a minute bounds a stuck upstream without cutting off uploads.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        limit_req zone=api_per_address burst=${EDGE_BURST} nodelay;
        # An edge refusal answers in the API's error shape; the API's own 429s pass through.
        error_page 429 = @edge_rate_limited;

        location ~ ^/api/requirements/[^/]+/impact-preview$ {
            proxy_pass ${API_UPSTREAM}$api_request_uri;
            limit_req zone=api_per_address burst=${EDGE_BURST} nodelay;
            limit_req zone=impact_preview_per_address burst=5 nodelay;
        }
    }

    location @edge_rate_limited {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Retry-After 1 always;
        default_type application/json;
        return 429 '{"code":"edge_rate_limited","message":"Too many requests from this address. Wait a moment and try again.","correlation_id":"$request_id"}';
    }

    # Client-side routes: every other path is the app shell, never cached, so a
    # deploy reaches browsers on their next navigation.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
