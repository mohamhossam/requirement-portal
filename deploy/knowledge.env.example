# The knowledge service's settings for deploy/compose.production.yaml.
# Copy to deploy/knowledge.env (git-ignored) and fill in every blank.
# The manifest itself sets PERSISTENCE_PROVIDER, DATABASE_URL (its own
# database), the scanner address, LOG_FORMAT=json, the metrics exporter, where
# requirement work is (REQUIREMENT_API_BASE_URL) and both service tokens.
# Every other variable is documented in knowledge-portal's .env.example.

APP_ENV=production

# Identity: the same issuer as requirement work, its own audience and client.
# Only actors with the knowledge_admin role get past sign-in.
IDENTITY_PROVIDER=oidc
OIDC_ISSUER_URL=
OIDC_AUDIENCE=knowledge-api
OIDC_CLIENT_ID=knowledge-spa

# Models for library search, catalogue reading and architecture matching.
# The manifest mounts the host directory KNOWLEDGE_LLM_CONFIG_DIR (default: the
# repository's config/) read-only at /app/config; set it where you run docker
# compose, not here.
LLM_PROVIDER=
# OPENAI_API_KEY=
# LLM_CONFIG_PATH=/app/config/llm.yaml

# Architecture matching uses the models chosen above. Set this to true only
# after the bilingual architecture evaluation passes on those models;
# production refuses to start without it.
KNOWLEDGE_EVALUATION_APPROVED=false

# Local model context. Reading architecture documents for catalogue suggestions
# splits each document to fit what is left for input (window minus output).
# LOCAL_LLM_CONTEXT_WINDOW_TOKENS=16384
# LOCAL_LLM_MAX_OUTPUT_TOKENS=8192

LIBRARY_SCAN_MODE=clamav

# Cost guard per actor per API replica.
PROVIDER_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
