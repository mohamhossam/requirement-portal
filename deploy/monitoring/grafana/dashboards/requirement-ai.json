{
  "uid": "requirement-ai-overview",
  "title": "Requirement AI — overview",
  "description": "API traffic, AI provider calls, token spend and background jobs from the api and worker exporters.",
  "tags": [
    "requirement-ai"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
