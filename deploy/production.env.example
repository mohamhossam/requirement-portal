# Requirement work's settings for deploy/compose.production.yaml.
# Copy to deploy/production.env (git-ignored) and fill in every blank.
# The manifest itself sets PERSISTENCE_PROVIDER, DATABASE_URL, the scanner
# address, LOG_FORMAT=json and the metrics exporter. Every other variable is
# documented in .env.example. The knowledge portal deploys on its own, from
# knowledge-portal's repository (ADR-0104).

APP_ENV=production

# Identity: production refuses the fake personas.
IDENTITY_PROVIDER=oidc
OIDC_ISSUER_URL=
OIDC_AUDIENCE=requirement-api
OIDC_CLIENT_ID=requirement-spa
# Also pass the issuer origin to the web image build (CSP_IDENTITY_ORIGINS),
# or the browser's Content-Security-Policy will block sign-in.

# The knowledge portal, optional (docs/operations/deployment.md, "Connecting the
# knowledge portal"). Leave these out to run requirement work alone. The URL is
# its API on the private network: http://knowledge-api:8000 with
# deploy/compose.peer.yaml. Each token is 32+ characters and named after the
# service that presents it; the knowledge portal holds the same two values.
# KNOWLEDGE_API_BASE_URL=http://knowledge-api:8000
# REQUIREMENT_SERVICE_TOKEN=
# KNOWLEDGE_SERVICE_TOKEN=

# Per-direction service credentials (ADR-0104; docs/operations/deployment.md,
# "Service credentials"). Optional: the shared tokens keep working beside them.
# REQUIREMENT_SERVICE_CLIENT_ID=requirement-service
# REQUIREMENT_SERVICE_CLIENT_SECRET=
# KNOWLEDGE_SERVICE_CLIENT_ID=knowledge-service

# Models: choose one provider (see .env.example), or model profiles instead.
# The manifest mounts the host directory LLM_CONFIG_DIR (default: the
# repository's config/) read-only at /app/config; set LLM_CONFIG_DIR where you
# run docker compose, not here. Setting LLM_CONFIG_PATH selects the profiles
# and LLM_PROVIDER is then ignored.
LLM_PROVIDER=
# OPENAI_API_KEY=
# LLM_CONFIG_PATH=/app/config/llm.yaml

# Local model context. Match the model server's context: e.g. 16384 for
# smb-qwen3-vl:8b-16k.
# LOCAL_LLM_CONTEXT_WINDOW_TOKENS=16384
# LOCAL_LLM_MAX_OUTPUT_TOKENS=4096

ATTACHMENT_SCAN_MODE=clamav

# Cost guard per actor per API replica.
PROVIDER_RATE_LIMIT_PER_MINUTE=30
# Days a read notification is kept before the retention command deletes it.
NOTIFICATION_RETENTION_DAYS=90
LOG_LEVEL=INFO
