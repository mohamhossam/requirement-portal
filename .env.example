# Copy to .env and fill in. Never commit .env.

# LLM backend: "openai" (default), "openrouter", "local", or "fake".
# "fake" runs the application end to end with a deterministic canned analysis
# and no provider account.
LLM_PROVIDER=fake

# Optional versioned profiles; when set, selects task models instead of legacy provider settings.
# LLM_CONFIG_PATH=config/llm.yaml
# Credentials referenced by selected model/embedding profiles only.
# GEMINI_API_KEY=
# COMPATIBLE_API_KEY=

# Required when LLM_PROVIDER=openai. Startup fails loudly if it is missing.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# Per-request timeout for every OpenAI structured call (seconds).
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Required when LLM_PROVIDER=openrouter. The default chat model is free but
# rate-limited and intended only for development/demo use. Knowledge embeddings
# use a separately billed model; OpenRouter never falls back to a paid chat model.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=120
# OPENROUTER_MAX_OUTPUT_TOKENS=8192
# OPENROUTER_DATA_COLLECTION=deny

# Required when LLM_PROVIDER=local. The default URL is LM Studio's local API;
# use http://127.0.0.1:11434/v1 for Ollama's OpenAI-compatible API.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
# For Ollama, create the deterministic project alias first:
# .\scripts\setup-local-ollama-model.ps1
# LOCAL_LLM_MODEL=smb-qwen3-vl:8b-16k
# Required for requirement knowledge search; must return 768 dimensions.
# LOCAL_EMBEDDING_MODEL=
# LOCAL_LLM_TIMEOUT_SECONDS=300
# Optional thinking control for compatible models: none, low, medium, or high.
# LOCAL_LLM_REASONING_EFFORT=
# Must fit the model/server context. The larger output reserve prevents
# structured analysis JSON from being truncated before its closing fields.
# LOCAL_LLM_CONTEXT_WINDOW_TOKENS=16384
# LOCAL_LLM_MAX_OUTPUT_TOKENS=8192
# Set true only when LOCAL_LLM_MODEL accepts OpenAI-compatible image inputs.
# LOCAL_LLM_VISION_ENABLED=false

# Opt-in development trace. The single JSONL file includes requirement text,
# prompts, raw final completions, parsed models, and citation comparisons.
# Credentials, image bytes, and hidden reasoning are always redacted. Delete the
# file after debugging and never share it without reviewing its contents.
DEBUG_TRACE_ENABLED=false
DEBUG_TRACE_PATH=logs/debug.log

# Durable storage. "memory" is offline/test mode. The local launcher starts and
# migrates Compose PostgreSQL; deployments run the documented migration command.
PERSISTENCE_PROVIDER=memory
# DATABASE_URL=postgresql://smb:smb_dev@127.0.0.1:5432/smb_requirements
# Per-process PostgreSQL connection pool (API and worker processes each have one).
# Size MAX for concurrent requests plus background workers; waiting longer than
# TIMEOUT for a free connection fails the request instead of hanging it.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=20
DATABASE_POOL_TIMEOUT_SECONDS=10

# Source Documents (PDF, DOCX, XLSX, TXT). PostgreSQL stores runtime blobs;
# DOCUMENT_STORAGE_PATH is retained only as the legacy migration import root.
DOCUMENT_MAX_FILE_BYTES=10485760
DOCUMENT_CONTEXT_MAX_CHARACTERS=60000
DOCUMENT_STORAGE_PATH=.data/documents
DOCUMENT_EXTRACTION_CONCURRENCY=2
DOCUMENT_EXTRACTION_QUEUE=4
DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=30
DOCUMENT_EXTRACTION_MEMORY_BYTES=536870912
DOCUMENT_MAX_PDF_PAGES=200
DOCUMENT_MAX_EXTRACTED_CHARACTERS=1000000
DOCUMENT_MAX_XML_NODES=250000
DOCUMENT_MAX_IMAGE_PIXELS=20000000
DOCUMENT_MAX_SPREADSHEET_CELLS=1000000

# Actor identity. Fake mode is deterministic and account-free for local work.
IDENTITY_PROVIDER=fake
# Required together when IDENTITY_PROVIDER=oidc. The issuer must use HTTPS.
# OIDC_ISSUER_URL=https://identity.example.com
# OIDC_AUDIENCE=requirement-api
# OIDC_CLIENT_ID=requirement-spa
# OIDC_SCOPES=openid profile email
# OIDC_ROLES_CLAIM=roles
# OIDC_COMPANY_SSO_ENABLED=true
# OIDC_COMPANY_SSO_ALIAS=company-sso
# OIDC_PASSWORD_LOGIN_ENABLED=true
# Explicit asymmetric JWT algorithm allowlist; symmetric algorithms are rejected.
# OIDC_ALLOWED_ALGORITHMS=RS256,ES256
# Signing keys refresh after 15 minutes. Unknown key IDs are negatively cached
# for 30 seconds, with a hard cap of 256 entries per issuer.
# OIDC_JWKS_TTL_SECONDS=900
# OIDC_UNKNOWN_KEY_TTL_SECONDS=30
# OIDC_UNKNOWN_KEY_CACHE_SIZE=256

# Durable model-backed work. PostgreSQL leases make workers safe across API replicas.
# true: the API process also runs every background worker (the default).
# false: HTTP only; run `python -m smb_requirement_agent.interfaces.worker`
# separately. Requires PERSISTENCE_PROVIDER=postgres.
API_BACKGROUND_WORKERS=true
AI_JOB_WORKER_CONCURRENCY=1
AI_JOB_POLL_INTERVAL_SECONDS=1
AI_JOB_LEASE_SECONDS=90
AI_JOB_HEARTBEAT_SECONDS=20
AI_JOB_SHUTDOWN_GRACE_SECONDS=150
# Attempts one job may start (a worker that dies mid-attempt still spends one).
# Past the cap the job fails as attempts_exhausted, retryable. Minimum 1.
AI_JOB_MAX_ATTEMPTS=3
# A job whose provider was rate limited or unavailable, or whose platform service could
# not be reached, waits and runs again (within AI_JOB_MAX_ATTEMPTS): first this many
# seconds, doubling each attempt up to the longest wait.
AI_JOB_RETRY_FIRST_SECONDS=30
AI_JOB_RETRY_MAX_SECONDS=300

# Cost guard: provider-calling operations (generation, analysis, AI jobs,
# knowledge search, architecture mapping and index builds, and creating or
# changing a Requirement, which queues knowledge screening) one actor may start
# per minute. With PostgreSQL the count is shared by every API process
# (ADR-0106). 0 disables the limit. Refusals return 429 with Retry-After.
PROVIDER_RATE_LIMIT_PER_MINUTE=30
# Spend cap: tokens the model providers may spend per UTC day, as their responses
# report them, across every process. Once spent, new AI jobs are refused (429,
# Retry-After until 00:00 UTC) and queued jobs wait for the next day; editing
# Requirements keeps working. 0 records spend without limiting it.
PROVIDER_DAILY_TOKEN_BUDGET=0

# Prior art from historic requirements (Knowledge Center E2, ADR-0102). Off by default:
# run `python scripts/evaluate_prior_art.py` against your provider before turning it on.
# The historic corpus is projected and indexed either way, so turning it on is instant.
PRIOR_ART_ENABLED=false
# At most this many prior-art judge calls an hour, across the portal.
PRIOR_ART_JUDGE_CALLS_PER_HOUR=60
# At most this many historic chunks embedded an hour, per historic requirement.
HISTORIC_EMBED_CHUNKS_PER_HOUR=500

# Days a read notification is kept before `python -m
# smb_requirement_agent.interfaces.retention` deletes it (ADR-0079).
NOTIFICATION_RETENTION_DAYS=90

# Largest request body the API reads (bytes). Multipart uploads may add one
# file of up to DOCUMENT_MAX_FILE_BYTES on top. Oversized bodies get 413.
REQUEST_MAX_BODY_BYTES=2097152

# --- Internal API (ADR-0099) ---
# The shared secret the knowledge service presents on /internal routes, 32+
# characters; give the knowledge service the same value. It reads document
# dependents, mapping counts and actor details there. Leave it empty when no
# knowledge portal is connected, in development or production (ADR-0104):
# every /internal path then answers 404. The edge proxy never routes
# /internal, whatever this holds.
KNOWLEDGE_SERVICE_TOKEN=
# Where the knowledge service's internal API is, and the token this service
# presents there (32+ characters). Set both to take library search,
# architecture matching, the event feed and the read-only viewers from the
# knowledge service; leave both empty to run offline, with no library and one
# empty catalogue version. Production may run either way (ADR-0104).
KNOWLEDGE_API_BASE_URL=
REQUIREMENT_SERVICE_TOKEN=
# Per-direction credentials (ADR-0104), in place of the shared tokens above or
# beside them while a deployment moves over. Each service holds only its own
# client secret; the OIDC issuer (OIDC_ISSUER_URL, HTTPS) grants it short-lived
# tokens, and the receiving service holds no secret at all.
# REQUIREMENT_SERVICE_CLIENT_ID and _SECRET name this service's client
# (requirement-service in deploy/keycloak); with them it no longer needs
# REQUIREMENT_SERVICE_TOKEN. KNOWLEDGE_SERVICE_CLIENT_ID names the knowledge
# service's client (knowledge-service): its tokens for the audience
# requirement-internal are admitted on /internal, as KNOWLEDGE_SERVICE_TOKEN is.
REQUIREMENT_SERVICE_CLIENT_ID=
REQUIREMENT_SERVICE_CLIENT_SECRET=
KNOWLEDGE_SERVICE_CLIENT_ID=

# Operational logs. LOG_FORMAT=json writes one JSON object per line, carrying
# the request correlation ID; use it wherever logs are shipped. These logs never
# contain requirement text or provider payloads (that is DEBUG_TRACE_ENABLED).
LOG_LEVEL=INFO
LOG_FORMAT=text

# Prometheus metrics on a separate port, never the public API. Unset disables
# the exporter. In a container, set METRICS_HOST=0.0.0.0 and keep the port
# off any public listener.
# METRICS_PORT=9464
METRICS_HOST=127.0.0.1

# Production refuses the offline fake actor, and needs the knowledge service.
APP_ENV=development

# Architecture matching runs in the knowledge service, which holds the
# KNOWLEDGE_EVALUATION_APPROVED production gate for its models (ADR-0099).

# Added by their own roadmap slices; unused today.
# ADO_ORGANIZATION=
# ADO_PROJECT=
# ADO_TOKEN=
# Attachment uploads: fail closed unless the local scanner returns a clean verdict.
# Formerly LIBRARY_SCAN_MODE, LIBRARY_SCANNER_HOST, LIBRARY_SCANNER_PORT and
# LIBRARY_OCR_ARTIFACTS_PATH; those names are still read for one release.
# offline is restricted to memory persistence plus fake identity; it is not malware protection.
ATTACHMENT_SCAN_MODE=clamav
ATTACHMENT_SCANNER_HOST=127.0.0.1
ATTACHMENT_SCANNER_PORT=3310
# Pre-downloaded local Docling models; no OCR model downloads during an upload.
ATTACHMENT_OCR_ARTIFACTS_PATH=
DOCUMENT_OFFICE_PREVIEW_EXECUTABLE=
