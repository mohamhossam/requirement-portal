    smb_requirement_agent.analysis
    smb_requirement_agent.breakdown
    smb_requirement_agent.governance
    smb_requirement_agent.reporting
# As for identity: jobs imports only the shared kernel and shared technical modules
# (application.errors, postgres_session, postgres_values), which still reach unmoved context code.
allow_indirect_imports = True

[importlinter:contract:jobs_published_surface]
name = Other contexts use jobs's domain and ports, never its adapters (ADR-0103 §5)
type = forbidden
# Context sources are their domain and application layers: infrastructure may reuse another
# context's codecs (revision snapshots serialise the whole tree, PR 12).
source_modules =
    smb_requirement_agent.domain
    smb_requirement_agent.application
    smb_requirement_agent.shared_kernel
    smb_requirement_agent.identity.domain
    smb_requirement_agent.identity.application
    smb_requirement_agent.requirements.domain
    smb_requirement_agent.requirements.application
    smb_requirement_agent.analysis.domain
    smb_requirement_agent.analysis.application
    smb_requirement_agent.breakdown.domain
    smb_requirement_agent.breakdown.application
    smb_requirement_agent.governance.domain
    smb_requirement_agent.governance.application
    smb_requirement_agent.reporting.application
forbidden_modules =
    smb_requirement_agent.jobs.infrastructure

[importlinter:contract:requirements_internal_layers]
name = requirements: infrastructure > application > domain
type = layers
containers =
    smb_requirement_agent.requirements
layers =
    infrastructure
    application
    domain

[importlinter:contract:requirements_depends_only_upstream]
name = requirements depends only on identity, jobs and the shared kernel (ADR-0103 §2)
type = forbidden
source_modules =
    smb_requirement_agent.requirements
forbidden_modules =
    smb_requirement_agent.domain
    smb_requirement_agent.application.use_cases
    smb_requirement_agent.application.ports
    smb_requirement_agent.interfaces
    smb_requirement_agent.analysis
    smb_requirement_agent.breakdown
    smb_requirement_agent.governance
    smb_requirement_agent.reporting
# The shared technical ports requirements uses, which every context may use.
ignore_imports =
    smb_requirement_agent.requirements.** -> smb_requirement_agent.application.ports.domain_events
    smb_requirement_agent.requirements.** -> smb_requirement_agent.application.ports.transaction_manager
# As for identity and jobs: the shared technical modules still reach unmoved context code.
allow_indirect_imports = True

[importlinter:contract:requirements_published_surface]
name = Other contexts use requirements' domain and ports, never its adapters (ADR-0103 §5)
type = forbidden
