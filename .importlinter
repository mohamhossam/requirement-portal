    smb_kernel.documents.scanner
    smb_kernel.documents.spreadsheet_extraction
    smb_kernel.documents.text_extractor
    smb_kernel.documents.word_extraction
    smb_kernel.llm
    smb_kernel.persistence
    smb_kernel.observability
    smb_kernel.http
    smb_kernel.diagnostics

[importlinter:contract:routes_no_kernel_adapters]
name = Routes and dependency providers do not select platform-kernel adapters
type = forbidden
source_modules =
    smb_requirement_agent.interfaces.api.routes
    smb_requirement_agent.interfaces.api.dependencies
forbidden_modules =
    smb_kernel.identity.oidc
    smb_kernel.identity.fake
    smb_kernel.documents.text_extractor
    smb_kernel.documents.bounded_extractor
    smb_kernel.documents.scanner
    smb_kernel.llm
    smb_kernel.persistence
allow_indirect_imports = True

# Bounded contexts (ADR-0103). A context gains these as it moves into its own package.

[importlinter:contract:identity_internal_layers]
name = identity: infrastructure > application > domain
type = layers
containers =
    smb_requirement_agent.identity
layers =
    infrastructure
    application
    domain

[importlinter:contract:identity_depends_on_no_other_context]
name = identity depends on no other context (ADR-0103 §2)
type = forbidden
source_modules =
    smb_requirement_agent.identity
forbidden_modules =
    smb_requirement_agent.domain
    smb_requirement_agent.application.use_cases
    smb_requirement_agent.application.ports
    smb_requirement_agent.interfaces
    smb_requirement_agent.jobs
    smb_requirement_agent.requirements
    smb_requirement_agent.analysis
    smb_requirement_agent.breakdown
    smb_requirement_agent.governance
    smb_requirement_agent.reporting
# Identity imports only the shared kernel and shared technical modules (application.errors, the
# payload and PostgreSQL helpers). Those still reach unmoved context code until their own contexts
# move, so only direct imports are checked here; PR 16 removes this exemption.
allow_indirect_imports = True

[importlinter:contract:identity_published_surface]
name = Other contexts use identity's domain and ports, never its adapters (ADR-0103 §5)
type = forbidden
# Context sources are their domain and application layers: infrastructure may reuse another
# context's codecs (revision snapshots serialise the whole tree, PR 12).
source_modules =
    smb_requirement_agent.domain
    smb_requirement_agent.application
    smb_requirement_agent.shared_kernel
    smb_requirement_agent.jobs.domain
    smb_requirement_agent.jobs.application
    smb_requirement_agent.requirements.domain
    smb_requirement_agent.requirements.application
    smb_requirement_agent.analysis.domain
    smb_requirement_agent.analysis.application
    smb_requirement_agent.breakdown.domain
    smb_requirement_agent.breakdown.application
    smb_requirement_agent.governance.domain
    smb_requirement_agent.governance.application
    smb_requirement_agent.reporting.application
forbidden_modules =
    smb_requirement_agent.identity.infrastructure

[importlinter:contract:jobs_internal_layers]
name = jobs: infrastructure > application > domain
type = layers
containers =
    smb_requirement_agent.jobs
layers =
    infrastructure
    application
    domain

