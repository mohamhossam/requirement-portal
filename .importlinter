    smb_requirement_agent.reporting.infrastructure
    smb_requirement_agent.workflows.infrastructure
    smb_requirement_agent.infrastructure.documents
    smb_requirement_agent.infrastructure.jobs
allow_indirect_imports = True

[importlinter:contract:infrastructure_not_interfaces]
name = Infrastructure must not depend on delivery interfaces
type = forbidden
source_modules =
