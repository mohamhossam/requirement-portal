    smb_requirement_agent.governance.infrastructure
    smb_requirement_agent.reporting.infrastructure
    smb_requirement_agent.workflows.infrastructure
allow_indirect_imports = True

[importlinter:contract:dependencies_no_adapter_selection]
name = Dependency providers obtain adapters from the composition root
type = forbidden
source_modules =
