    smb_requirement_agent.requirements
    smb_requirement_agent.analysis
    smb_requirement_agent.breakdown
    smb_requirement_agent.governance
    smb_requirement_agent.reporting
    smb_requirement_agent.workflows

[importlinter:contract:application_independence]
name = Application must not depend on infrastructure or interfaces
type = forbidden
source_modules =
    smb_requirement_agent.application
    smb_requirement_agent.identity.application
    smb_requirement_agent.jobs.application
    smb_requirement_agent.requirements.application
    smb_requirement_agent.analysis.application
    smb_requirement_agent.breakdown.application
    smb_requirement_agent.governance.application
    smb_requirement_agent.reporting.application
    smb_requirement_agent.workflows.application
forbidden_modules =
    smb_requirement_agent.infrastructure
    smb_requirement_agent.interfaces
    smb_requirement_agent.identity.infrastructure
    smb_requirement_agent.jobs.infrastructure
    smb_requirement_agent.requirements.infrastructure
    smb_requirement_agent.analysis.infrastructure
    smb_requirement_agent.breakdown.infrastructure
    smb_requirement_agent.governance.infrastructure
    smb_requirement_agent.reporting.infrastructure
    smb_requirement_agent.workflows.infrastructure

[importlinter:contract:domain_framework_independence]
name = Domain must not import frameworks or provider SDKs
type = forbidden
source_modules =
    smb_requirement_agent.domain
    smb_requirement_agent.shared_kernel
    smb_requirement_agent.identity.domain
    smb_requirement_agent.jobs.domain
    smb_requirement_agent.requirements.domain
    smb_requirement_agent.analysis.domain
    smb_requirement_agent.breakdown.domain
    smb_requirement_agent.governance.domain
forbidden_modules =
    fastapi
    pydantic
    psycopg
    openai
    httpx
    sqlalchemy

[importlinter:contract:application_framework_independence]
name = Application must not import delivery, persistence, or provider SDKs
type = forbidden
source_modules =
    smb_requirement_agent.application
    smb_requirement_agent.identity.application
    smb_requirement_agent.jobs.application
    smb_requirement_agent.requirements.application
    smb_requirement_agent.analysis.application
    smb_requirement_agent.breakdown.application
    smb_requirement_agent.governance.application
    smb_requirement_agent.reporting.application
    smb_requirement_agent.workflows.application
forbidden_modules =
    fastapi
    psycopg
    openai
    sqlalchemy
    httpx

[importlinter:contract:routes_no_adapter_selection]
name = Routes cannot select concrete infrastructure adapters
type = forbidden
source_modules =
    smb_requirement_agent.interfaces.api.routes
forbidden_modules =
    smb_requirement_agent.infrastructure
    smb_requirement_agent.identity.infrastructure
