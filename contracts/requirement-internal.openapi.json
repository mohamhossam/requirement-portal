  "info": {
    "title": "Requirement service internal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/architecture-mapping/stats": {
      "get": {
        "operationId": "mapping_stats_internal_architecture_mapping_stats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MappingCount"
                  },
                  "title": "Response Mapping Stats Internal Architecture Mapping Stats Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Mapping Stats",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/knowledge/corpus": {
      "get": {
        "description": "The corpus Requirement by Requirement: identity and state, never content.",
        "operationId": "knowledge_corpus_internal_knowledge_corpus_get",
        "parameters": [
          {
            "in": "query",
            "name": "index_state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/IndexState"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Index State"
            }
          },
          {
            "in": "query",
            "name": "owner_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Owner Id"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 200,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "open_findings_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Open Findings Only",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "not_screened_for_days",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 3650,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Not Screened For Days"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Knowledge Corpus",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/knowledge/corpus/summary": {
      "get": {
        "description": "Requirement knowledge corpus health for the Knowledge Center: counts only.",
        "operationId": "corpus_summary_internal_knowledge_corpus_summary_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorpusSummary"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Corpus Summary",
        "tags": [
          "internal"
        ]
      }
    },
    "/internal/knowledge/findings": {
      "get": {
        "description": "Findings in force across the corpus, the longest-standing first.",
        "operationId": "knowledge_findings_internal_knowledge_findings_get",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/KnowledgeRelationshipKind"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "age",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FindingAge"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Age"
            }
          },
          {
            "in": "query",
            "name": "owner_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Owner Id"
            }
