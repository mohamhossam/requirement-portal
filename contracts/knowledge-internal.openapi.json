        "description": "Exact citable passage plus bounded, non-authoritative retrieval context.",
        "properties": {
          "citation": {
            "$ref": "#/components/schemas/PublishedReference"
          },
          "context_locations": {
            "items": {
              "type": "string"
            },
            "title": "Context Locations",
            "type": "array"
          },
          "context_text": {
            "title": "Context Text",
            "type": "string"
          }
        },
        "required": [
          "citation",
          "context_text",
          "context_locations"
        ],
        "title": "ReferenceEvidence",
        "type": "object"
      },
      "RelationshipKind": {
        "description": "How the source system depends on the target, when a source says so.",
        "enum": [
          "calls_api",
          "publishes_events_to",
          "transfers_data_to",
          "orchestrates",
          "unspecified"
        ],
        "title": "RelationshipKind",
        "type": "string"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SystemCapability": {
        "properties": {
          "component_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Component Id"
          },
          "component_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Component Name"
          },
          "domain_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain Id"
          },
          "domain_path": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Domain Path",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "SystemCapability",
        "type": "object"
      },
      "SystemReference": {
        "properties": {
          "capabilities": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SystemCapability"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "catalogued": {
            "title": "Catalogued",
            "type": "boolean"
          },
          "constraints": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Constraints",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "products": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/OrganisationReference"
            },
            "title": "Products",
            "type": "array"
          },
          "squads": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/OrganisationReference"
            },
            "title": "Squads",
            "type": "array"
          },
          "value_streams": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/OrganisationReference"
            },
            "title": "Value Streams",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "catalogued"
        ],
        "title": "SystemReference",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Knowledge service internal API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/architecture/match": {
      "post": {
        "operationId": "match_internal_architecture_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArchitectureQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchitectureKnowledgeMatch"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Match"
      }
    },
    "/internal/architecture/releases/{release_id}/evidence/{chunk_id}": {
      "get": {
        "description": "Evidence of a published release; a draft answers 404.",
        "operationId": "evidence_internal_architecture_releases__release_id__evidence__chunk_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "release_id",
            "required": true,
            "schema": {
              "title": "Release Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "chunk_id",
            "required": true,
            "schema": {
              "title": "Chunk Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceChunk"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evidence"
      }
    },
    "/internal/change-requests": {
      "post": {
        "description": "An approved backlog, kept once per final approval for a knowledge admin to read into a\ndraft (requirement-portal ADR-0101, step 7). Delivering the same approval again answers\n200 with the first change request; the same approval for another subject is a 409.",
        "operationId": "receive_change_request_internal_change_requests_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovedBacklogRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The same approval was delivered before."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeRequestReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Receive Change Request"
      }
    },
    "/internal/events": {
      "get": {
        "operationId": "events_internal_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "After",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Events Internal Events Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Events"
      }
    },
    "/internal/library/passages": {
      "get": {
        "description": "A cited passage, only while its publication is live (409 otherwise).",
        "operationId": "passage_internal_library_passages_get",
        "parameters": [
          {
            "in": "query",
            "name": "document_id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Document Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "publication_id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Publication Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "version_id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Version Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision_id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Revision Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "block_id",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Block Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitedPassage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Passage"
      }
    },
    "/internal/library/published": {
      "get": {
        "operationId": "published_internal_library_published_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedResponse"
                }
              }
